{
  "name": "cappan-coffee-projectweb",
  "version": "4.2.0",
  "private": true,
  "description": "CAPPAN – Coffee & More · Home Study. Web quán cà phê: đặt bàn, gọi món, theo dõi đơn, trợ lý AI, thu ngân tại quầy và quản trị nhân viên.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:dist": "node scripts/serve.mjs --dist",
    "test": "node --test \"tests/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "test:ai": "node --test \"tests/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "lint": "node scripts/lint.mjs",
    "normalize": "node scripts/normalize-pages.mjs",
    "sync": "node scripts/sync-layout.mjs",
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --mode prod",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm test && npm run build && npm run verify && npm run smoke"
  }
}
