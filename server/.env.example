# Sao chép tệp này thành server/.env rồi điền key.
# Tệp .env KHÔNG commit (đã có trong .gitignore).

# --- Groq (https://console.groq.com/keys) ---
# Nhiều key thì ngăn cách bằng dấu phẩy
GROQ_KEYS=

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_KEYS=

# Chỉ cho phép các model này (để trống = mọi model hợp lệ của provider)
ALLOWED_MODELS=

# auto = localhost/127.0.0.1 + file://; * = tất cả (chỉ để thử); hoặc danh sách origin
ALLOWED_ORIGINS=auto

# Cổng proxy
PORT=8787

# Giới hạn
MAX_TOKENS=1500
MAX_BODY_KB=256
RATE_PER_MIN=60

# Đặt 1 nếu muốn chặn request không có Origin (khi đưa lên mạng)
REQUIRE_ORIGIN=0

# Token phụ (chỉ dùng khi gọi từ server khác; web hiện không gửi)
ACCESS_TOKEN=
